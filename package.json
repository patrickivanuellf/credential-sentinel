{
  "name": "credential-sentinel",
  "version": "0.1.0",
  "description": "Pemindai kredensial bocor (API key, token, private key) di repo lokal atau GitHub publik milik sendiri/dengan izin.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sentinel": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
